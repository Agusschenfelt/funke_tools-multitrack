# Production env for the multitrack stack. Copy to /opt/multitrack/env.prod ON THE VPS and fill in.
# Never commit the real file. Generate secrets on the server, e.g.:
#   openssl rand -hex 24   # passwords (URL-safe hex only; they are embedded in connection URLs)
#   openssl rand -hex 32   # SIGNING_SECRET

# Name of the Docker network Caddy is attached to (found with `docker inspect core-caddy-1`).
CADDY_NETWORK=core_default

# Public URLs. Only two variables carry them, and each has one consumer:
#  - NEXT_PUBLIC_API_URL: where the BROWSER calls the API. Read at web image BUILD time (build arg),
#    so changing it needs a rebuild: `docker compose ... build mt-web && up -d`.
#  - CORS_ORIGINS: exact origin(s) of the web app that the API accepts (comma separated, no path).
#    Same-origin single host never triggers CORS, but keep it equal to the web origin.
# Single host with the API under /api (Caddy strips the prefix):
NEXT_PUBLIC_API_URL=https://tool.example.com/api
CORS_ORIGINS=https://tool.example.com
# Separate API host instead: NEXT_PUBLIC_API_URL=https://api.example.com (CORS_ORIGINS stays the web origin)

POSTGRES_USER=multitrack
POSTGRES_DB=multitrack
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
REDIS_PASSWORD=generate-with-openssl-rand-hex-24
SIGNING_SECRET=generate-with-openssl-rand-hex-32

# Must match the Caddy request_body max_size (+ multipart overhead) and the web build arg.
MAX_UPLOAD_MB=100
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# Songs expire after 24 h (fixed in the API; SONG_TTL_HOURS is read only by the manual orphan sweep
# `python -m worker_cpu.cleanup`, keep it 24). The API sweep runs every CLEANUP_INTERVAL_SECONDS.
SONG_TTL_HOURS=24
CLEANUP_INTERVAL_SECONDS=900
LOST_JOB_GRACE_SECONDS=300

# Abuse limits. Per client IP per hour: uploads and job creation (429 + Retry-After; 0 disables).
# MAX_QUEUE_DEPTH: new jobs get 503 while more than this many wait for the single worker.
# TRUST_PROXY_HEADERS=1 reads the client IP from the right-most X-Forwarded-For entry, which Caddy
# sets; keep it 1 here since the API is only reachable through Caddy (otherwise every client would
# share Caddy's IP and one limit).
UPLOAD_RATE_LIMIT_PER_HOUR=10
JOB_RATE_LIMIT_PER_HOUR=30
MAX_QUEUE_DEPTH=20
TRUST_PROXY_HEADERS=1

# Concurrency is 1 by design: worker_cpu is a single RQ process, so one job runs at a time.
