# Copy to infra/.env and set real values locally. Never commit infra/.env.
POSTGRES_USER=multitrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=multitrack
SIGNING_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:3000
CLEANUP_INTERVAL_SECONDS=900
LOST_JOB_GRACE_SECONDS=300
# Per-IP requests per hour for POST /songs and job creation (0 disables; off by default in dev),
# and the queue length above which new jobs get 503 (0 disables).
UPLOAD_RATE_LIMIT_PER_HOUR=0
JOB_RATE_LIMIT_PER_HOUR=0
MAX_QUEUE_DEPTH=20
# 1 only behind a reverse proxy that sets X-Forwarded-For; otherwise clients could spoof their IP.
TRUST_PROXY_HEADERS=0
REDIS_PASSWORD=replace-with-openssl-rand-hex-24
